{
  "name": "pr-clip",
  "description": "Copy a GitHub pull request as a clean, shareable one-liner for chat apps like Slack.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Guillermo Tamanaha",
  "homepage": "https://github.com/guillermot/pr-clip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillermot/pr-clip.git"
  },
  "bugs": "https://github.com/guillermot/pr-clip/issues",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "store:assets": "wxt build && node scripts/store-assets.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
